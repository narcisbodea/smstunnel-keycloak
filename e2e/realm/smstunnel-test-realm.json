{
  "realm": "smstunnel-test",
  "displayName": "SMSTunnel Test",
  "enabled": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ro"],
  "defaultLocale": "en",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "browserFlow": "browser with SMSTunnel",
  "requiredActions": [
    {
      "alias": "smstunnel-phone-number",
      "name": "SMSTunnel: add a phone number",
      "providerId": "smstunnel-phone-number",
      "enabled": true,
      "defaultAction": false,
      "priority": 100,
      "config": {}
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser with SMSTunnel",
      "description": "The password, then a code by SMS through SMSTunnel",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "browser with SMSTunnel forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser with SMSTunnel forms",
      "description": "Username and password, then the SMS code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "smstunnel-sms-code",
          "authenticatorConfig": "SMSTunnel test",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "SMSTunnel test",
      "config": {
        "apiKey": "${vault.smstunnel_api_key}",
        "baseUrl": "${SMSTUNNEL_BASE_URL}",
        "defaultCountryCode": "+1",
        "phoneAttribute": "phoneNumber",
        "codeLength": "6",
        "codeTtl": "300",
        "maxAttempts": "3",
        "maxSends": "3",
        "resendAfter": "5"
      }
    }
  ],
  "clients": [
    {
      "clientId": "test-app",
      "name": "SMSTunnel test app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/smstunnel-e2e/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "test-app-legacy-theme",
      "name": "SMSTunnel test app (older login theme)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/smstunnel-e2e/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "login_theme": "keycloak"
      }
    }
  ],
